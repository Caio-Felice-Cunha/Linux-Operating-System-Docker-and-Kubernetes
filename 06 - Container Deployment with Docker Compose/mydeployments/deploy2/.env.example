# Copy this file to .env in the same folder before running `docker compose up`.
# .env is gitignored so real values never get committed. These are demo/study
# values; pick your own for any real use.

# Node API environment (used by my_api as NODE_ENV)
MY_ENVIRONMENT=development

# Postgres credentials (used by my_database)
POSTGRES_DB=mydb
POSTGRES_USER=justme
POSTGRES_PASSWORD=mypasswordhere
